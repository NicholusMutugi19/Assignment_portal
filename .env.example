# Copy to .env or set these in the production environment before running migrations.
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=assignment_portal
DB_USER=your_db_user
DB_PASS=change-me-strong-password
DB_SSL_MODE=REQUIRED

PORTAL_EXTENSIONS_ENABLED=true
EDUCATION_COURSE_TARGETING_ENABLED=false
MPESA_ENABLED=false
MAINTENANCE_MODE=false
APP_URL=https://your-domain.example.com
SESSION_NAME=ap_session
TIMEZONE=Africa/Nairobi

# One-time bootstrap admin credentials for the initial admin account.
BOOTSTRAP_ADMIN_NAME=Admin Nicholus
BOOTSTRAP_ADMIN_EMAIL=admin@assignmentportal.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisStrongPassword16+
